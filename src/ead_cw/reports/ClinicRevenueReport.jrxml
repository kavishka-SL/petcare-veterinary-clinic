	<query language="SQL"><![CDATA[SELECT
    py.payment_id AS payment_id,
    py.payment_date AS payment_date,
    a.appointment_id AS appointment_number,
    c.full_name AS customer_name,
    p.pet_name AS pet_name,
    s.service_name AS service_name,
    v.full_name AS veterinarian_name,
    py.payment_method AS payment_method,
    py.amount AS amount
FROM payments py
INNER JOIN appointments a
    ON py.appointment_id = a.appointment_id
INNER JOIN pets p
    ON a.pet_id = p.pet_id
INNER JOIN customers c
    ON p.customer_id = c.customer_id
INNER JOIN services s
    ON a.service_id = s.service_id
INNER JOIN veterinarians v
    ON a.veterinarian_id = v.veterinarian_id
ORDER BY py.payment_date DESC, py.payment_id DESC]]></query>
