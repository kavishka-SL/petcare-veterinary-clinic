<jasperReport name="BillableItemUsageReport" language="java"
        pageWidth="842" pageHeight="595" orientation="Landscape"
        columnWidth="802" leftMargin="20" rightMargin="20"
        topMargin="20" bottomMargin="20" whenNoDataType="NoDataSection"
        uuid="4710bbc2-f839-4db6-b413-058979319b46">

    <style name="Base" fontName="Segoe UI" fontSize="8.0"/>
    <style name="Header" style="Base" mode="Opaque" backcolor="#2F5597" forecolor="#FFFFFF" bold="true" hTextAlign="Center" vTextAlign="Middle"/>
    <style name="Cell" style="Base" vTextAlign="Middle"/>
    <style name="Amount" style="Cell" hTextAlign="Right"/>

    <query language="SQL"><![CDATA[
SELECT
    a.appointment_id AS appointment_number,
    c.full_name AS customer_name,
    p.pet_name,
    bi.item_type,
    bi.item_name,
    s.service_name,
    ai.quantity,
    ai.unit_price,
    (ai.quantity * ai.unit_price) AS subtotal
FROM appointment_items ai
INNER JOIN billable_items bi ON ai.item_id = bi.item_id
INNER JOIN appointments a ON ai.appointment_id = a.appointment_id
INNER JOIN pets p ON a.pet_id = p.pet_id
INNER JOIN customers c ON p.customer_id = c.customer_id
INNER JOIN services s ON bi.service_id = s.service_id
ORDER BY a.appointment_id DESC, ai.appointment_item_id
    ]]></query>

    <field name="appointment_number" class="java.lang.Integer"/>
    <field name="customer_name" class="java.lang.String"/>
    <field name="pet_name" class="java.lang.String"/>
    <field name="item_type" class="java.lang.String"/>
    <field name="item_name" class="java.lang.String"/>
    <field name="service_name" class="java.lang.String"/>
    <field name="quantity" class="java.lang.Integer"/>
    <field name="unit_price" class="java.math.BigDecimal"/>
    <field name="subtotal" class="java.math.BigDecimal"/>

    <variable name="TotalItemRevenue" class="java.math.BigDecimal" calculation="Sum">
        <expression><![CDATA[$F{subtotal}]]></expression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>

    <background splitType="Stretch"/>
    <title height="60" splitType="Stretch">
