            <element kind="textField" style="Amount" pattern="#,##0.00" uuid="f14d7ae0-b79f-47e3-8cd1-ccae0b649354" x="720" y="0" width="82" height="24"><expression><![CDATA[$F{subtotal}]]></expression></element>
