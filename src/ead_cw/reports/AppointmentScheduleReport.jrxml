<jasperReport name="AppointmentScheduleReport" language="java"
        pageWidth="842" pageHeight="595" orientation="Landscape"
        columnWidth="802" leftMargin="20" rightMargin="20"
        topMargin="20" bottomMargin="20" whenNoDataType="NoDataSection"
        uuid="aa8c3811-7a15-4e41-a387-ad179e5fe011">

    <style name="Base" fontName="Segoe UI" fontSize="8.0"/>
    <style name="Header" style="Base" mode="Opaque" backcolor="#2F5597"
            forecolor="#FFFFFF" bold="true" hTextAlign="Center" vTextAlign="Middle"/>
    <style name="Cell" style="Base" vTextAlign="Middle"/>

    <query language="SQL"><![CDATA[
SELECT
    a.appointment_id,
    a.appointment_date,
    TIME_FORMAT(a.appointment_time, '%H:%i') AS appointment_time,
    c.full_name AS customer_name,
    p.pet_name,
    s.service_name,
    v.full_name AS veterinarian_name,
    COALESCE(a.symptoms, '-') AS symptoms,
    a.status
FROM appointments a
INNER JOIN pets p ON a.pet_id = p.pet_id
INNER JOIN customers c ON p.customer_id = c.customer_id
INNER JOIN services s ON a.service_id = s.service_id
INNER JOIN veterinarians v ON a.veterinarian_id = v.veterinarian_id
ORDER BY a.appointment_date DESC, a.appointment_time DESC
    ]]></query>

    <field name="appointment_id" class="java.lang.Integer"/>
    <field name="appointment_date" class="java.sql.Date"/>
    <field name="appointment_time" class="java.lang.String"/>
    <field name="customer_name" class="java.lang.String"/>
    <field name="pet_name" class="java.lang.String"/>
    <field name="service_name" class="java.lang.String"/>
    <field name="veterinarian_name" class="java.lang.String"/>
    <field name="symptoms" class="java.lang.String"/>
    <field name="status" class="java.lang.String"/>

    <background splitType="Stretch"/>
    <title height="60" splitType="Stretch">
        <element kind="staticText" uuid="6e079cc3-98df-4cc2-a5ec-b751cc64a701" x="0" y="0" width="802" height="30" forecolor="#01043D" fontName="Segoe UI" fontSize="22.0" bold="true" hTextAlign="Center"><text><![CDATA[PetCare Veterinary Clinic]]></text></element>
        <element kind="staticText" uuid="20cc76d2-18f0-44d6-88fa-92e2fde5e75e" x="0" y="35" width="802" height="20" fontName="Segoe UI" fontSize="12.0" hTextAlign="Center"><text><![CDATA[Appointment Schedule Report]]></text></element>
    </title>
    <pageHeader height="20" splitType="Stretch">
