    </columnHeader>
    <detail>
        <band height="24" splitType="Stretch">
            <element kind="textField" style="Cell" uuid="8a24efef-44b9-4b4d-8461-8809fe4ec9bf" x="0" y="0" width="55" height="24"><expression><![CDATA[$F{appointment_id}]]></expression></element>
            <element kind="textField" style="Cell" pattern="yyyy-MM-dd" uuid="8e270543-b32f-45e5-9005-15b9cf47c3ed" x="55" y="0" width="70" height="24"><expression><![CDATA[$F{appointment_date}]]></expression></element>
            <element kind="textField" style="Cell" uuid="df862daa-a184-41b9-9cc8-eab9f6c52923" x="125" y="0" width="50" height="24"><expression><![CDATA[$F{appointment_time}]]></expression></element>
