    <summary height="36" splitType="Stretch">
        <element kind="textField" uuid="b3701bd8-1296-4a0d-b9a2-36e4ba6cdd61" x="550" y="4" width="250" height="28" forecolor="#17365D" fontName="Segoe UI" fontSize="12.0" bold="true" hTextAlign="Right"><expression><![CDATA["Total Treatments: " + $V{REPORT_COUNT}]]></expression></element>
    </summary>
    <noData height="45" splitType="Stretch">
        <element kind="staticText" uuid="a42b28dc-599b-4ec9-9c12-7064eb98d680" x="0" y="10" width="802" height="25" fontName="Segoe UI" fontSize="12.0" hTextAlign="Center"><text><![CDATA[No treatment records are available.]]></text></element>
