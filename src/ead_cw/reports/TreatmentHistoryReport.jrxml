            <element kind="textField" style="Cell" pattern="yyyy-MM-dd" uuid="362a18d2-3854-4409-8750-fb9ad5056819" x="55" y="0" width="70" height="28"><expression><![CDATA[$F{treatment_date}]]></expression></element>
            <element kind="textField" style="Cell" uuid="f6474b43-f49e-40bc-b725-a435dd9dd6e4" x="125" y="0" width="55" height="28"><expression><![CDATA[$F{appointment_number}]]></expression></element>
            <element kind="textField" style="Cell" uuid="668b4d4d-9a57-4f39-995d-364ece66a147" x="180" y="0" width="110" height="28"><expression><![CDATA[$F{customer_name}]]></expression></element>
