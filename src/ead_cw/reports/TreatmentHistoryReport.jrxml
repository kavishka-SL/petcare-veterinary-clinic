<jasperReport name="TreatmentHistoryReport" language="java"
        pageWidth="842" pageHeight="595" orientation="Landscape"
        columnWidth="802" leftMargin="20" rightMargin="20"
        topMargin="20" bottomMargin="20" whenNoDataType="NoDataSection"
        uuid="7286cda7-0544-4dfb-9c68-af8fa6a1556b">

    <style name="Base" fontName="Segoe UI" fontSize="8.0"/>
    <style name="Header" style="Base" mode="Opaque" backcolor="#2F5597" forecolor="#FFFFFF" bold="true" hTextAlign="Center" vTextAlign="Middle"/>
    <style name="Cell" style="Base" vTextAlign="Middle"/>

    <query language="SQL"><![CDATA[
SELECT
    t.treatment_id,
    t.treatment_date,
    a.appointment_id AS appointment_number,
    c.full_name AS customer_name,
    p.pet_name,
    v.full_name AS veterinarian_name,
    t.diagnosis,
    COALESCE(t.notes, '-') AS care_instructions
FROM treatments t
INNER JOIN appointments a ON t.appointment_id = a.appointment_id
INNER JOIN pets p ON a.pet_id = p.pet_id
INNER JOIN customers c ON p.customer_id = c.customer_id
INNER JOIN veterinarians v ON a.veterinarian_id = v.veterinarian_id
ORDER BY t.treatment_date DESC, t.treatment_id DESC
    ]]></query>

    <field name="treatment_id" class="java.lang.Integer"/>
    <field name="treatment_date" class="java.sql.Date"/>
    <field name="appointment_number" class="java.lang.Integer"/>
    <field name="customer_name" class="java.lang.String"/>
    <field name="pet_name" class="java.lang.String"/>
    <field name="veterinarian_name" class="java.lang.String"/>
    <field name="diagnosis" class="java.lang.String"/>
    <field name="care_instructions" class="java.lang.String"/>

    <background splitType="Stretch"/>
    <title height="60" splitType="Stretch">
        <element kind="staticText" uuid="c0d8e3fd-7c88-48f0-9fda-4f3be7fc385c" x="0" y="0" width="802" height="30" forecolor="#01043D" fontName="Segoe UI" fontSize="22.0" bold="true" hTextAlign="Center"><text><![CDATA[PetCare Veterinary Clinic]]></text></element>
        <element kind="staticText" uuid="142350cb-6774-42b8-bcb5-4d088ee84117" x="0" y="35" width="802" height="20" fontName="Segoe UI" fontSize="12.0" hTextAlign="Center"><text><![CDATA[Treatment History Report]]></text></element>
    </title>
    <pageHeader height="20" splitType="Stretch">
