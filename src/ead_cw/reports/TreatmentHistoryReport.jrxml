            <element kind="textField" style="Cell" uuid="017706aa-586a-457b-ad38-54b9bb409840" x="645" y="0" width="157" height="28"><expression><![CDATA[$F{care_instructions}]]></expression></element>
        </band>
    </detail>
    <pageFooter height="24" splitType="Stretch">
